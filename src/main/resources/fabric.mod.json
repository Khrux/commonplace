{
	"schemaVersion": 1,
	"id": "commonplace",
	"version": "${version}",
	"name": "Commonplace",
	"description": "One book for your recipes, the creatures you've met, the land you've mapped and your own notes, shared with whoever knows the passphrase.",
	"authors": [
		"khrux"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/commonplace",
		"sources": "https://github.com/Khrux/commonplace",
		"issues": "https://github.com/Khrux/commonplace/issues"
	},
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/commonplace/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.khrux.commonplace.Commonplace"
		],
		"client": [
			"com.khrux.commonplace.client.CommonplaceClient"
		],
		"fabric-datagen": [
			"com.khrux.commonplace.datagen.CommonplaceDataGenerator"
		],
		"modmenu": [
			"com.khrux.commonplace.client.CommonplaceModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"mixins": [
		"commonplace.mixins.json",
		{
			"config": "commonplace.client.mixins.json",
			"environment": "client"
		}
	],
	"contributors": [
		"Hunternif, tyra314 and Sisby folk (Antique Atlas art, LGPL-3.0-or-later)",
		"Evan Bowness and Kobber (Field Guide, MIT, bundled: https://github.com/evanbones/FieldGuide)"
	]
}
